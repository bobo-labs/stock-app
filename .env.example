PORT=3000
# Add a Railway Postgres database and Railway will provide DATABASE_URL.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Optional local JSON database location. On Railway, attach a volume and set:
# DATA_PATH=/data/inventory.json

# Optional: populate an empty local database with demonstration products.
# SEED_DEMO_DATA=true

# Protect the counter and live card-payment routes with a staff PIN.
# Use a long, random SESSION_SECRET in Railway.
# STAFF_PIN=1234
# SESSION_SECRET=replace-with-a-long-random-value

# Mercado Pago Point Smart 2 (production credentials and terminal ID).
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
# MERCADOPAGO_POINT_TERMINAL_ID=...
# MERCADOPAGO_WEBHOOK_SECRET=...

# Pilot receipt output. The bundled thermal logo prints as a separate image action.
# POINT_PILOT_RECEIPT_ENABLED=true
# POINT_PILOT_LOGO_ENABLED=true

# Local development only: simulate an approved Point payment without credentials.
# MERCADOPAGO_MOCK=true

# Optional override for integration testing. Production uses the default API URL.
# MERCADOPAGO_API_BASE=https://api.mercadopago.com
