{
  "name": "bakery-counter-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "check": "node --check server/index.js && node --check server/store.js && node --check server/mercadopago.js && node --check server/auth.js && node --check src/dates.js",
    "test": "node --test --test-concurrency=1 server/*.test.js"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^7.1.7"
  }
}
